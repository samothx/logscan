# logscan: daily security review of the journal and nginx logs (rules + optional LLM skills).
# Runs as the unprivileged system user `logscan`; log access via groups adm + systemd-journal.
[Unit]
Description=logscan: security review of journal and nginx logs
Documentation=file:///usr/local/share/doc/logscan/README.md
Wants=network-online.target
After=network-online.target
# A crash or a journal read failure (exit 2) is reported via ntfy (handler from ai-sysadm 0031).
OnFailure=ntfy-job-failed@%N.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/logscan --config /etc/logscan/config.toml run
User=logscan
# Primary group adm: reports in /var/lib/logscan are readable by adm members (thomas).
Group=adm
SupplementaryGroups=systemd-journal ntfy-senders logscan
StateDirectory=logscan
StateDirectoryMode=0750
UMask=0027
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
MemoryMax=768M

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# ntfy-dispatcher (child process) spools undelivered messages here.
ReadWritePaths=/var/spool/ntfy-dispatcher
